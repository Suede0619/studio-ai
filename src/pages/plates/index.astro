---
import BaseLayout from "../../layouts/BaseLayout.astro";

const upcoming = [
  "Your brand shouldn't live in a PDF.",
  "How we make on-brand decks in 5 days, not 5 weeks.",
  "What working artists actually need from AI tools.",
  "The Visual Cortex: a working brain for your brand.",
  "Glaze, Nightshade, and the artist's posture in the AI age.",
  "Tools we use ourselves — and the ones we don't.",
];
---

<BaseLayout title="Plates — Nrvana Studio">
  <section class="section pt-24 pb-12">
    <h1 class="font-display text-6xl font-semibold tracking-tight leading-[0.95]">
      Plates.
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Essays on visual identity, AI tools we actually use, and how working artists stay relevant without losing their voice.
    </p>
  </section>

  <section class="section py-12">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-warm);">
      <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">First six, in flight</div>
      <ul class="mt-4 space-y-3 font-display text-xl">
        {upcoming.map((u) => <li>· {u}</li>)}
      </ul>
      <p class="mt-6 text-sm" style="color: var(--color-ink-soft);">
        We're publishing one a week starting soon. Want them in your inbox? Email
        <a href="mailto:hi@nrvana.com?subject=Studio%20Notes" class="underline underline-offset-4">hi@nrvana.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
