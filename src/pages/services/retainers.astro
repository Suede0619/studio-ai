---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF } from "../../siteConfig";
---

<BaseLayout title="Monthly Support · Nrvana Studio">
  <section class="section pt-24 pb-12">
    <h1 class="font-display text-6xl font-semibold tracking-tight leading-[0.95] max-w-4xl">
      Keep looking great. <em>A little every month.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Once your brand is set up, we stick around to keep it fresh and make one new thing a month with you,
      as your taste grows and the tools keep getting better.
    </p>
  </section>

  <section class="section py-12">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border p-8" style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">For you · Individual</div>
        <h2 class="mt-3 font-display text-3xl font-semibold">Monthly Support</h2>
        <div class="mt-2 font-display text-2xl">$500–$1,500 / mo</div>
        <ul class="mt-6 space-y-2 text-sm" style="color: var(--color-ink-soft);">
          <li>· One new template, set of pieces, or campaign each month</li>
          <li>· We keep your brand kit and prompts fresh</li>
          <li>· An hour of design help, whenever you need it</li>
          <li>· First look at new AI design tools we've tried and trust</li>
        </ul>
      </div>

      <div class="rounded-2xl border p-8" style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-alt);">For your team · 2–50</div>
        <h2 class="mt-3 font-display text-3xl font-semibold">Team Monthly Support</h2>
        <div class="mt-2 font-display text-2xl">$2,500–$7,500 / mo</div>
        <ul class="mt-6 space-y-2 text-sm" style="color: var(--color-ink-soft);">
          <li>· One new piece, campaign, or template each month</li>
          <li>· We keep your team's brand kit and prompts fresh</li>
          <li>· Email help plus 90 minutes with us each month</li>
          <li>· We try the new tools so your team doesn't have to</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-canvas-warm);">
      <p class="font-display text-3xl">Cancel anytime. <em>The setup is still yours.</em></p>
      <div class="mt-6">
        <a href={CALL_HREF} class="btn-accent">Book a free 30-minute call</a>
      </div>
    </div>
  </section>
</BaseLayout>
