---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Retainers — Nrvana Studio">
  <section class="section pt-24 pb-12">
    <h1 class="font-display text-6xl font-semibold tracking-tight leading-[0.95] max-w-4xl">
      Compound. <em>One asset at a time.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      After Cortex or Sprint, retainers keep your visual layer current as your taste evolves and the tools shift.
    </p>
  </section>

  <section class="section py-12">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border p-8" style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">For you · Individual</div>
        <h2 class="mt-3 font-display text-3xl font-semibold">Studio Retainer</h2>
        <div class="mt-2 font-display text-2xl">$500–$1,500 / mo</div>
        <ul class="mt-6 space-y-2 text-sm" style="color: var(--color-ink-soft);">
          <li>· 1 new template, asset system, or campaign installed each month</li>
          <li>· Brand Kernel + Prompt Library maintenance</li>
          <li>· 60 minutes of synchronous art direction</li>
          <li>· Early access to new AI design tools we've actually vetted</li>
        </ul>
      </div>

      <div class="rounded-2xl border p-8" style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-alt);">For your team · 2–50</div>
        <h2 class="mt-3 font-display text-3xl font-semibold">Team Studio Retainer</h2>
        <div class="mt-2 font-display text-2xl">$2,500–$7,500 / mo</div>
        <ul class="mt-6 space-y-2 text-sm" style="color: var(--color-ink-soft);">
          <li>· 1 brand-adjacent asset, campaign, or template per month</li>
          <li>· Brand Kernel + Prompt Library maintenance</li>
          <li>· Async + 90 minutes synchronous time / month</li>
          <li>· New-tool vetting + integration as the field moves</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-canvas-warm);">
      <p class="font-display text-3xl">Cancel anytime. <em>The setup is still yours.</em></p>
      <div class="mt-6">
        <a href="/contact?ref=retainer" class="btn-primary">Talk through a retainer</a>
      </div>
    </div>
  </section>
</BaseLayout>
