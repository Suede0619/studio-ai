---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF } from "../../siteConfig";

const ladder = [
  { step: "01", title: "Start with a free call", desc: "A relaxed 30-minute look at your brand and where it could shine. No pitch, no jargon, no commitment.", href: CALL_HREF, price: "Free · 30 min" },
  { step: "02", title: "Get a Snapshot", desc: "In a few days we review your look, map your tools, and hand you a plan plus a starter setup. From $250.", href: "/services/snapshot", price: "from $250" },
  { step: "03", title: "Have us set it all up", desc: "We build your full brand kit and the tools that use it, then keep it fresh month to month if you'd like.", href: "/services/visual-cortex", price: "$2,500+" },
];

const offerings = [
  { name: "Design Snapshot", audience: "Individual", length: "3 days", price: "$450", href: "/services/snapshot", out: "Plan + your first on-brand setup" },
  { name: "Personal Visual Cortex", audience: "Individual", length: "5–7 days", price: "$2,500", href: "/services/visual-cortex", out: "Your brand kit + tools, set up" },
  { name: "Monthly Support", audience: "Individual", length: "ongoing", price: "$500–$1,500/mo", href: "/services/retainers", out: "One new piece a month" },
  { name: "Brand Sprint", audience: "Team", length: "2–4 weeks", price: "$5k–$15k", href: "/services/brand-sprint", out: "A full brand + templates" },
  { name: "Pitch Deck Sprint", audience: "Team", length: "1–2 weeks", price: "$2.5k–$5k", href: "/services/pitch-deck", out: "A deck + your brand kit" },
  { name: "Brand Setup for Teams", audience: "Team", length: "1–2 weeks", price: "$4k–$8k", href: "/services/visual-system", out: "A working system on your brand" },
  { name: "Team Monthly Support", audience: "Team", length: "ongoing", price: "$2.5k–$7.5k/mo", href: "/services/retainers", out: "Ongoing brand help" },
  { name: "Artist Style Snapshot", audience: "Artist", length: "2 days", price: "$250", href: "/for-artists/snapshot", out: "Your voice captured + tool map" },
  { name: "Artist Cortex", audience: "Artist", length: "5 days", price: "$1,200", href: "/for-artists/cortex", out: "Your style, set up to amplify" },
];
---

<BaseLayout title="Services · Nrvana Studio">
  <section class="section pt-24 pb-16">
    <h1 class="font-display text-6xl font-semibold tracking-tight leading-[0.95]">
      Start small. <em>Grow at your pace.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      A free chat to see if it's a fit. A Snapshot to get going. A full setup when you're ready.
      Pick the rung that fits you today: individuals, teams, and artists each have their own path.
    </p>
  </section>

  <section class="section pb-20">
    <div class="grid gap-6 md:grid-cols-3">
      {ladder.map((l) => (
        <a href={l.href} class="rounded-2xl border p-8 transition hover:-translate-y-1"
           style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">{l.step}</div>
          <h3 class="mt-3 font-display text-3xl font-semibold">{l.title}</h3>
          <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">{l.desc}</p>
          <div class="mt-6 text-sm font-medium">{l.price} →</div>
        </a>
      ))}
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-4xl font-semibold">Everything we offer</h2>
    <p class="mt-2 text-sm" style="color: var(--color-ink-mute);">Most people start with a free call or a Snapshot. The rest is here when you need it.</p>
    <div class="mt-8 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b text-left text-xs uppercase tracking-wider"
              style="border-color: var(--color-line); color: var(--color-ink-mute);">
            <th class="py-3 pr-4">What it is</th>
            <th class="py-3 pr-4">For</th>
            <th class="py-3 pr-4">Length</th>
            <th class="py-3 pr-4">Price</th>
            <th class="py-3 pr-4">You get</th>
            <th class="py-3"></th>
          </tr>
        </thead>
        <tbody>
          {offerings.map((o) => (
            <tr class="border-b" style="border-color: var(--color-line);">
              <td class="py-4 pr-4 font-medium">{o.name}</td>
              <td class="py-4 pr-4" style="color: var(--color-ink-soft);">{o.audience}</td>
              <td class="py-4 pr-4" style="color: var(--color-ink-soft);">{o.length}</td>
              <td class="py-4 pr-4 font-medium">{o.price}</td>
              <td class="py-4 pr-4" style="color: var(--color-ink-soft);">{o.out}</td>
              <td class="py-4"><a href={o.href} class="underline underline-offset-4">See →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-canvas-warm);">
      <p class="font-display text-3xl">Not sure where to start? <em>Let's just talk.</em></p>
      <div class="mt-6">
        <a href={CALL_HREF} class="btn-accent">Book a free 30-minute call</a>
      </div>
    </div>
  </section>
</BaseLayout>
