---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Pitch Deck Sprint — Nrvana Studio">
  <section class="section pt-24 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-alt);">For your team</div>
    <h1 class="mt-4 font-display text-6xl font-semibold tracking-tight leading-[0.95] max-w-4xl">
      A deck that doesn't look like every other deck. <em>In 5–10 days.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Investor decks, sales decks, partner decks. We shape the story before we shape the slides — built with AI, finished by hand. You walk away with your brand kit, so you can make the next one yourself.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-3"
         style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div><div class="mt-1 font-display text-2xl font-semibold">1–2 weeks</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Slides</div><div class="mt-1 font-display text-2xl font-semibold">12–25 slides</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Fee</div><div class="mt-1 font-display text-2xl font-semibold" style="color: var(--color-accent-deep);">$2.5k–$5k</div></div>
    </div>
  </section>

  <section class="section py-12">
    <ul class="space-y-3" style="color: var(--color-ink-soft);">
      <li>· Discovery + narrative work — we shape the story first.</li>
      <li>· 12–25 slides, end-to-end.</li>
      <li>· AI-augmented production — image generation, layout drafting, then hand-finished.</li>
      <li>· 2 rounds of revisions.</li>
      <li>· An editable working file you update yourself going forward.</li>
      <li>· Your brand kit and prompt set, so you can make the next deck yourself.</li>
    </ul>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-4xl font-semibold">Book a Pitch Deck Sprint.</h2>
      <div class="mt-8">
        <a href="/contact?ref=pitch-deck" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-accent); color: var(--color-canvas);">Talk through a deck →</a>
      </div>
    </div>
  </section>
</BaseLayout>
