---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF, SNAPSHOT_HREF } from "../../siteConfig";

const deliverables = [
  { name: "Your Look, Reviewed", desc: "We look at everything that carries your brand today — deck, social, website, email signature — and show you what's working and what's holding you back." },
  { name: "Your Tool Map", desc: "Which AI design tools are worth paying for, which to skip, and the one to start with. A short, honest shortlist — no overwhelm." },
  { name: "Your Top 3 Quick Wins", desc: "The three upgrades that will make the biggest difference, in order, with the easiest one first." },
  { name: "Your Starter Prompt Kit", desc: "15–25 ready-to-use prompts tuned to your style, so you can make polished, on-brand pieces from day one." },
  { name: "Your Next Step", desc: "An honest recommendation — keep going on your own, or have us set up the full thing. Your call, no pressure." },
];

const schedule = [
  { day: "Day 1", title: "A friendly chat", desc: "45 minutes with us. We learn your style and what you're trying to pull off. You don't prep a thing." },
  { day: "Day 2", title: "We do the work", desc: "We review your look, build your tool map, and tune your starter prompts. You carry on with your day." },
  { day: "Day 3", title: "We walk you through it", desc: "60 minutes together. We hand it all over and make sure you feel confident using it." },
];
---

<BaseLayout title="Design Snapshot — $450 · Nrvana Studio">
  <section class="section pt-24 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">For you · Individual</div>
    <h1 class="mt-4 font-display text-6xl font-semibold tracking-tight leading-[0.95]">
      Make your brand look the part. <em>In 3 days.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Five clear deliverables. A simple plan. Your first on-brand AI setup, ready to use. All yours
      to keep — no design background needed.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-4"
         style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div>
        <div class="mt-1 font-display text-2xl font-semibold">3 days</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">You get</div>
        <div class="mt-1 font-display text-2xl font-semibold">5 deliverables</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Your time</div>
        <div class="mt-1 font-display text-2xl font-semibold">~2 hours</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Price</div>
        <div class="mt-1 font-display text-2xl font-semibold" style="color: var(--color-accent-deep);">$450 flat</div>
      </div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-4xl font-semibold">What you walk away with</h2>
    <ol class="mt-10 space-y-7">
      {deliverables.map((d, i) => (
        <li class="flex gap-6">
          <div class="font-display text-3xl font-semibold" style="color: var(--color-accent); min-width: 2.5rem;">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div>
            <h3 class="font-display text-2xl font-medium">{d.name}</h3>
            <p class="mt-2" style="color: var(--color-ink-soft);">{d.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-4xl font-semibold">How the three days go</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {schedule.map((s) => (
        <div class="rounded-2xl border p-6" style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">{s.day}</div>
          <h4 class="mt-2 font-display text-2xl font-medium">{s.title}</h4>
          <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section py-16">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-warm);">
      <p class="font-display text-3xl">
        The plan is yours. <em>Take it with you.</em>
      </p>
      <p class="mt-3" style="color: var(--color-ink-soft);">
        Everything above is yours to keep. No retainer, no lock-in, no pressure to continue.
      </p>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-4xl font-semibold">Ready when you are.</h2>
      <p class="mt-3" style="color: var(--color-canvas-soft);">Book the Snapshot — or start with a free chat if you'd like to talk first.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={SNAPSHOT_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-accent); color: var(--color-ink);">
          Book the Snapshot — $450
        </a>
        <a href={CALL_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">
          Book a free 20-minute call
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
