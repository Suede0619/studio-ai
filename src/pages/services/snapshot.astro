---
import BaseLayout from "../../layouts/BaseLayout.astro";

const deliverables = [
  { name: "Your Style Snapshot", desc: "Every brand-touching asset you have today — deck, social, LinkedIn, website, email signature — assessed for what works and what doesn't." },
  { name: "Your Tool Map", desc: "The AI design tools you pay for, mapped to outcomes. Recommendations for what to drop, what to add, what to actually use." },
  { name: "Your Top-3 Visual Wins", desc: "The three highest-leverage upgrades, in order, with effort-to-impact ranking." },
  { name: "Your Starter Prompt Library", desc: "15–25 prompts tuned to your context that work across Midjourney, Recraft, Krea, and the rest of the current stack." },
  { name: "Your Next Step", desc: "Explicit recommendation: stop here and DIY, or continue with a Visual Cortex." },
];

const schedule = [
  { day: "Day 1", title: "Intake call", desc: "45 minutes with us. Plus we send a small kit — drop your current brand assets in a folder, no formatting required." },
  { day: "Day 2", title: "Synthesis", desc: "We build the snapshot, the tool map, the prompt library, and the recommendation." },
  { day: "Day 3", title: "Walkthrough", desc: "60-minute walkthrough. You keep every artifact." },
];

const notFor = [
  "Anyone shopping for AI to replace their designer. Hard line.",
  "Anyone wanting a $99 logo. That race is to the bottom.",
  "Anyone wanting an 'AI strategy deck.' We ship artifacts, not slides.",
];
---

<BaseLayout title="Design Snapshot — $450 · Nrvana Studio">
  <section class="section pt-24 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">For you · Individual</div>
    <h1 class="mt-4 font-display text-6xl font-semibold tracking-tight leading-[0.95]">
      See where your visual work is leaking. <em>In 3 days.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Five named artifacts. One acceleration plan. Yours to keep.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-4"
         style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div>
        <div class="mt-1 font-display text-2xl font-semibold">3 days</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Deliverables</div>
        <div class="mt-1 font-display text-2xl font-semibold">5 named</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Your time</div>
        <div class="mt-1 font-display text-2xl font-semibold">2–3 hours</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Fee</div>
        <div class="mt-1 font-display text-2xl font-semibold" style="color: var(--color-accent-deep);">$450 flat</div>
      </div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-4xl font-semibold">What you walk away with</h2>
    <ol class="mt-10 space-y-7">
      {deliverables.map((d, i) => (
        <li class="flex gap-6">
          <div class="font-display text-3xl font-semibold" style="color: var(--color-accent); min-width: 2.5rem;">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div>
            <h3 class="font-display text-2xl font-medium">{d.name}</h3>
            <p class="mt-2" style="color: var(--color-ink-soft);">{d.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-4xl font-semibold">The three days</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {schedule.map((s) => (
        <div class="rounded-2xl border p-6" style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">{s.day}</div>
          <h4 class="mt-2 font-display text-2xl font-medium">{s.title}</h4>
          <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section py-16">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-warm);">
      <p class="font-display text-3xl">
        The plan is yours. <em>take it with you.</em>
      </p>
      <p class="mt-3" style="color: var(--color-ink-soft);">
        Every artifact above is yours to keep. No retainer. No lock-in. No upsell pressure.
      </p>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-2xl font-semibold">This is not for you if…</h2>
    <ul class="mt-6 space-y-3 text-sm" style="color: var(--color-ink-soft);">
      {notFor.map((n) => <li>· {n}</li>)}
    </ul>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-4xl font-semibold">Book the Snapshot.</h2>
      <p class="mt-3" style="color: var(--color-canvas-soft);">Launch price. Three days. Yours to keep.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact?ref=snapshot" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-accent); color: var(--color-canvas);">
          Book — $450
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">
          Talk first — just say hi
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
