---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF, SNAPSHOT_HREF } from "../../siteConfig";

const deliverables = [
  { name: "Your Brand Kit", desc: "A simple file that captures your colors, type, voice, and the look you love — so any AI tool can instantly make work that's on-brand." },
  { name: "Your Prompt Set", desc: "50–80 ready-to-use prompts for the things you make most — decks, social posts, headers, covers, profile photos — each tuned to your style." },
  { name: "Your Tool Setup", desc: "The handful of AI design tools actually worth your time, set up with your brand loaded in and billing sorted. Open and go." },
  { name: "Two templates, ready to use", desc: "A deck template and a social template, both wired so you (or anyone on your team) can make polished, on-brand work in about ten minutes." },
  { name: "A weekly 15-minute habit", desc: "A quick routine that keeps everything fresh as your taste grows. We teach it. You own it." },
];
---

<BaseLayout title="Your Visual Cortex — $2,500 · Nrvana Studio">
  <section class="section pt-24 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">For you · Individual</div>
    <h1 class="mt-4 font-display text-6xl font-semibold tracking-tight leading-[0.95] max-w-4xl">
      Your brand shouldn't live in a PDF. <em>It should live where the work gets made.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      We build the simple kit — your brand, your prompts, your tools — that makes every AI tool produce
      polished, on-brand work in your voice. Then we hand it to you to keep. We call it your Visual Cortex.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-4"
         style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div><div class="mt-1 font-display text-2xl font-semibold">5–7 days</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">You get</div><div class="mt-1 font-display text-2xl font-semibold">5 deliverables</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Your time</div><div class="mt-1 font-display text-2xl font-semibold">A few short calls</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Price</div><div class="mt-1 font-display text-2xl font-semibold" style="color: var(--color-accent-deep);">$2,500 flat</div></div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-4xl font-semibold">What you walk away with</h2>
    <ol class="mt-10 space-y-7">
      {deliverables.map((d, i) => (
        <li class="flex gap-6">
          <div class="font-display text-3xl font-semibold" style="color: var(--color-accent); min-width: 2.5rem;">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div>
            <h3 class="font-display text-2xl font-medium">{d.name}</h3>
            <p class="mt-2" style="color: var(--color-ink-soft);">{d.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section py-12">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-warm);">
      <p class="font-display text-3xl">
        It goes where you go. <em>Yours to keep.</em>
      </p>
      <p class="mt-3" style="color: var(--color-ink-soft);">
        Your brand kit and prompts work with any AI tool you choose — today and in the future. They're yours, and they travel with you, always.
      </p>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-4xl font-semibold">Ready to look the part?</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={SNAPSHOT_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-accent); color: var(--color-canvas);">Book — $2,500</a>
        <a href={CALL_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">Book a free 30-minute call first</a>
      </div>
    </div>
  </section>
</BaseLayout>
