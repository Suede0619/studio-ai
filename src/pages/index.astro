---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CALL_HREF } from "../siteConfig";

const stats = [
  { num: "Days", label: "to set up, not weeks or months" },
  { num: "On-brand", label: "every deck, post, and page looks like it belongs together" },
  { num: "Your voice", label: "AI tuned to your style, not a generic look" },
  { num: "Yours", label: "everything we make is yours to keep" },
];

const doorways = [
  {
    label: "For you",
    headline: "Look like you've got a design team.",
    body: "Solo founders, consultants, creators. We set up your brand and the AI tools that use it, so your slides, posts, and pages finally look as good as your work.",
    cta: { href: "/services/snapshot", label: "Start with the Snapshot ($450)" },
    sub: { href: "/services/visual-cortex", label: "Or the full setup →" },
    accent: "var(--color-accent)",
  },
  {
    label: "For your team",
    headline: "A brand your whole team can use.",
    body: "2 to 50 people. We build your look and the simple kit that keeps everything consistent, so anyone can make on-brand work in minutes, not days.",
    cta: { href: "/services/brand-sprint", label: "See a Brand Sprint" },
    sub: { href: "/services/pitch-deck", label: "Or a Pitch Deck Sprint →" },
    accent: "var(--color-accent-alt)",
  },
  {
    label: "For artists",
    headline: "Your voice, louder.",
    body: "Working illustrators, designers, photographers, video artists. Sized-right pricing, artist-first. We treat your style as the asset and put AI to work amplifying it.",
    cta: { href: "/for-artists", label: "See the Artist Path (from $250)" },
    sub: { href: "/for-artists/snapshot", label: "Or jump to the Style Snapshot →" },
    accent: "var(--color-ink)",
  },
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="section pt-24 pb-20">
    <h1 class="font-display text-6xl md:text-7xl font-semibold tracking-tight max-w-4xl leading-[0.95]">
      Your slides look like every other deck. <em>Yours shouldn't.</em>
    </h1>
    <p class="mt-8 max-w-2xl text-lg md:text-xl" style="color: var(--color-ink-soft);">
      We set up the AI design tools and a simple brand kit they all read from, so everything you
      make looks sharp, consistent, and unmistakably yours. In days, not months. No design skills needed.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href={CALL_HREF} class="btn-accent">
        Book a free 30-minute call
      </a>
      <a href="/services/snapshot" class="btn-ghost">Or start with the $450 Snapshot →</a>
    </div>
    <p class="mt-4 text-sm" style="color: var(--color-ink-mute);">
      No pitch, no jargon. Just a friendly look at how good your brand could look.
    </p>
  </section>

  <!-- THESIS -->
  <section class="py-24" style="background-color: var(--color-canvas-warm);">
    <div class="section-narrow">
      <p class="text-center font-display text-3xl md:text-5xl leading-tight">
        We make the people who do the work
        <br />
        <em style="color: var(--color-accent-deep);">look as good as the work they do.</em>
      </p>
    </div>
  </section>

  <!-- THREE DOORWAYS -->
  <section class="section py-24">
    <div class="grid gap-8 md:grid-cols-3">
      {doorways.map((d) => (
        <article class="rounded-2xl border p-8 transition hover:-translate-y-1"
                 style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
          <div class="text-xs uppercase tracking-widest" style={`color: ${d.accent};`}>{d.label}</div>
          <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold leading-[1.05]">{d.headline}</h2>
          <p class="mt-5" style="color: var(--color-ink-soft);">{d.body}</p>
          <div class="mt-8 flex flex-col gap-3">
            <a href={d.cta.href} class="btn-primary w-fit">{d.cta.label}</a>
            <a href={d.sub.href} class="text-sm underline underline-offset-4" style="color: var(--color-ink-soft);">
              {d.sub.label}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- STAT SLAB -->
  <section class="section py-24">
    <div class="mb-10">
      <h3 class="font-display text-3xl font-semibold">What you get.</h3>
      <p class="mt-2 text-sm" style="color: var(--color-ink-mute);">No design background required. We do the craft; you get the credit.</p>
    </div>
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
      {stats.map((s) => (
        <div class="border-l-2 pl-5" style="border-color: var(--color-accent);">
          <div class="font-display text-5xl font-semibold" style="color: var(--color-ink);">{s.num}</div>
          <div class="mt-2 text-sm" style="color: var(--color-ink-soft);">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- METHOD PREVIEW -->
  <section class="section py-24">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <div class="font-display text-4xl font-semibold" style="color: var(--color-accent);">01</div>
        <h4 class="mt-2 font-display text-2xl font-medium">We capture your look</h4>
        <p class="mt-3" style="color: var(--color-ink-soft);">
          Your colors, type, voice, and the references you love, written down as a simple brand kit that any AI tool can read.
        </p>
      </div>
      <div>
        <div class="font-display text-4xl font-semibold" style="color: var(--color-accent);">02</div>
        <h4 class="mt-2 font-display text-2xl font-medium">We set up the tools</h4>
        <p class="mt-3" style="color: var(--color-ink-soft);">
          Prompts and templates, all tuned to your brand, so you can make a polished deck or post in about ten minutes.
        </p>
      </div>
      <div>
        <div class="font-display text-4xl font-semibold" style="color: var(--color-accent);">03</div>
        <h4 class="mt-2 font-display text-2xl font-medium">You make it your own</h4>
        <p class="mt-3" style="color: var(--color-ink-soft);">
          A quick weekly habit keeps it fresh as your taste grows. We teach it. You own it.
        </p>
      </div>
    </div>
    <div class="mt-12">
      <a href="/method" class="btn-ghost px-0">See how it works →</a>
    </div>
  </section>

  <!-- ARTIST CALLOUT -->
  <section class="section py-24">
    <div class="rounded-3xl p-10 md:p-14"
         style="background-color: var(--color-ink); color: var(--color-canvas);">
      <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">For working artists</div>
      <h3 class="mt-4 font-display text-4xl md:text-5xl font-semibold max-w-3xl leading-tight">
        We respect your process. <em>We just want it to be louder.</em>
      </h3>
      <p class="mt-6 max-w-2xl" style="color: var(--color-canvas-soft);">
        Your voice is the asset. AI is a power tool you steer. We built a sized-right path that keeps your
        hands on the work and your signature on every piece, so you make more, reach further, and stay in demand.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/for-artists" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-accent); color: var(--color-canvas);">
          See the Artist Path (from $250)
        </a>
        <a href={CALL_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">
          Or book a free chat
        </a>
      </div>
    </div>
  </section>

  <!-- FIRST COHORT NOTE -->
  <section class="section py-20">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-soft);">
      <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">Our first clients</div>
      <h3 class="mt-3 font-display text-3xl font-medium">
        We're taking on our first handful of clients now.
      </h3>
      <p class="mt-3 max-w-2xl" style="color: var(--color-ink-soft);">
        Real names, real before-and-afters, and real results will land here. Want to be one of the
        first, at the launch price? That's exactly why this page exists.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={CALL_HREF} class="btn-accent">Book a free 30-minute call</a>
        <a href="/services/snapshot" class="btn-ghost">Or the $450 Snapshot →</a>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-display text-4xl md:text-5xl leading-tight">
        Your brand, your tools, your templates. <em>Take it with you.</em>
      </p>
      <p class="mt-6" style="color: var(--color-ink-soft);">
        Everything we make for you is yours to keep. Start with a free chat and see how good it could look.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href={CALL_HREF} class="btn-accent">Book a free 30-minute call</a>
        <a href="/services/snapshot" class="btn-ghost">Or start with the $450 Snapshot →</a>
      </div>
    </div>
  </section>
</BaseLayout>
