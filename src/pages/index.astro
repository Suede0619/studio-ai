---
import BaseLayout from "../layouts/BaseLayout.astro";

const stats = [
  { num: "5 days", label: "to install a Visual Cortex" },
  { num: "12+", label: "AI design tools vetted across image, video, 3D, vector, pitch" },
  { num: "0", label: "designers replaced. Ever." },
  { num: "100%", label: "of artifacts are yours to keep" },
];

const doorways = [
  {
    label: "For you",
    headline: "You, faster. On-brand.",
    body: "Solo founders, consultants, creators, operators. We install your Brand Kernel, Prompt Library, and the two templates you'll use every week.",
    cta: { href: "/services/snapshot", label: "Start with the Snapshot — $450" },
    sub: { href: "/services/visual-cortex", label: "Or the full Visual Cortex →" },
    accent: "var(--color-accent)",
  },
  {
    label: "For your team",
    headline: "Your team, harder to outwork.",
    body: "2 to 50 people. We ship full brand systems and ongoing templates — built AI-augmented, finished by hand.",
    cta: { href: "/services/brand-sprint", label: "Brand & Visual Sprint" },
    sub: { href: "/services/pitch-deck", label: "Or a Pitch Deck Sprint →" },
    accent: "var(--color-accent-alt)",
  },
  {
    label: "For artists",
    headline: "Your voice, louder.",
    body: "Working illustrators, designers, photographers, video artists. Sized-right pricing, artist-first stance. We respect your process.",
    cta: { href: "/for-artists", label: "See the Artist Path — from $250" },
    sub: { href: "/for-artists/snapshot", label: "Or jump to the Style Snapshot →" },
    accent: "var(--color-ink)",
  },
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="section pt-24 pb-20">
    <h1 class="font-display text-6xl md:text-7xl font-semibold tracking-tight max-w-4xl leading-[0.95]">
      Your slides look like every other deck. <em>Yours shouldn't.</em>
    </h1>
    <p class="mt-8 max-w-2xl text-lg md:text-xl" style="color: var(--color-ink-soft);">
      We install the AI-augmented design toolkits — Brand Kernels, Prompt Libraries, Visual Cortexes — that amplify the people doing the design work. We never replace them.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/services/snapshot" class="btn-accent">
        Book the Design Snapshot — $450 · 3 days
      </a>
      <a href="/contact" class="btn-ghost">Just say hi</a>
    </div>
  </section>

  <!-- THESIS -->
  <section class="py-24" style="background-color: var(--color-canvas-warm);">
    <div class="section-narrow">
      <p class="text-center font-display text-3xl md:text-5xl leading-tight">
        We amplify the humans doing the design work.
        <br />
        <em style="color: var(--color-accent-deep);">We never replace them — especially not the artists.</em>
      </p>
    </div>
  </section>

  <!-- THREE DOORWAYS -->
  <section class="section py-24">
    <div class="grid gap-8 md:grid-cols-3">
      {doorways.map((d) => (
        <article class="rounded-2xl border p-8 transition hover:-translate-y-1"
                 style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
          <div class="text-xs uppercase tracking-widest" style={`color: ${d.accent};`}>{d.label}</div>
          <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold leading-[1.05]">{d.headline}</h2>
          <p class="mt-5" style="color: var(--color-ink-soft);">{d.body}</p>
          <div class="mt-8 flex flex-col gap-3">
            <a href={d.cta.href} class="btn-primary w-fit">{d.cta.label}</a>
            <a href={d.sub.href} class="text-sm underline underline-offset-4" style="color: var(--color-ink-soft);">
              {d.sub.label}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- STAT SLAB -->
  <section class="section py-24">
    <div class="mb-10">
      <h3 class="font-display text-3xl font-semibold">What we ship.</h3>
      <p class="mt-2 text-sm" style="color: var(--color-ink-mute);">Numbers we lead with — chosen for what AI unlocks, not what it abandons.</p>
    </div>
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
      {stats.map((s) => (
        <div class="border-l-2 pl-5" style="border-color: var(--color-accent);">
          <div class="font-display text-5xl font-semibold" style="color: var(--color-ink);">{s.num}</div>
          <div class="mt-2 text-sm" style="color: var(--color-ink-soft);">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- METHOD PREVIEW -->
  <section class="section py-24">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <div class="font-display text-4xl font-semibold" style="color: var(--color-accent);">01</div>
        <h4 class="mt-2 font-display text-2xl font-medium">Capture</h4>
        <p class="mt-3" style="color: var(--color-ink-soft);">
          Your visual identity gets written down — colors, type, voice, references, anti-references. The Brand Kernel any AI tool can load.
        </p>
      </div>
      <div>
        <div class="font-display text-4xl font-semibold" style="color: var(--color-accent);">02</div>
        <h4 class="mt-2 font-display text-2xl font-medium">Install</h4>
        <p class="mt-3" style="color: var(--color-ink-soft);">
          Prompts, templates, tool loadout — all tuned to your kernel. Wired so you (or a non-designer) can produce on-brand work in 10 minutes.
        </p>
      </div>
      <div>
        <div class="font-display text-4xl font-semibold" style="color: var(--color-accent);">03</div>
        <h4 class="mt-2 font-display text-2xl font-medium">Amplify</h4>
        <p class="mt-3" style="color: var(--color-ink-soft);">
          A 15-minute weekly ritual keeps the kernel current. Your taste evolves; the system follows. We teach it. You own it.
        </p>
      </div>
    </div>
    <div class="mt-12">
      <a href="/method" class="btn-ghost px-0">See the full method →</a>
    </div>
  </section>

  <!-- ARTIST CALLOUT -->
  <section class="section py-24">
    <div class="rounded-3xl p-10 md:p-14"
         style="background-color: var(--color-ink); color: var(--color-canvas);">
      <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">For working artists</div>
      <h3 class="mt-4 font-display text-4xl md:text-5xl font-semibold max-w-3xl leading-tight">
        We respect your process. <em>We just want it to be louder.</em>
      </h3>
      <p class="mt-6 max-w-2xl" style="color: var(--color-canvas-soft);">
        Two years of "AI will replace illustrators" headlines. We don't buy it. Your voice is the asset; AI is a power tool you steer. We built a sized-right path so you can engage on your terms — and stay relevant without losing what makes the work yours.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/for-artists" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-accent); color: var(--color-canvas);">
          See the Artist Path — from $250
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">
          Or just say hi
        </a>
      </div>
    </div>
  </section>

  <!-- FIRST COHORT NOTE -->
  <section class="section py-20">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-soft);">
      <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">Our first cohort</div>
      <h3 class="mt-3 font-display text-3xl font-medium">
        We are running our first paid Snapshots and Visual Cortexes now.
      </h3>
      <p class="mt-3 max-w-2xl" style="color: var(--color-ink-soft);">
        Real names, real before/afters, and real outcomes from our first clients will land here. If you want to be one of those names — at the launch price — that's why this page exists.
      </p>
      <div class="mt-6">
        <a href="/services/snapshot" class="btn-accent">Book the Snapshot — $450</a>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-display text-4xl md:text-5xl leading-tight">
        Your kernel, your library, your templates. <em>take it with you.</em>
      </p>
      <p class="mt-6" style="color: var(--color-ink-soft);">
        Every artifact we make for you is yours to keep. No retainer required. No lock-in.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/services/snapshot" class="btn-accent">Book the Design Snapshot — $450</a>
        <a href="/contact" class="btn-ghost">Just say hi</a>
      </div>
    </div>
  </section>
</BaseLayout>
