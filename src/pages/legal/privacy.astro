---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy · Nrvana Studio">
  <section class="section pt-20 pb-20 max-w-3xl">
    <h1 class="font-display text-5xl font-semibold">Privacy</h1>
    <p class="mt-6" style="color: var(--color-ink-soft);">
      Short version: we don't store, sell, or reuse anything we learn about you or your work without your written consent. For artists, this includes a hard line: we do not use your work to train models, and we do not include your work as training data in any client deliverable.
    </p>
    <p class="mt-4" style="color: var(--color-ink-soft);">
      Full policy landing soon. Questions to <a href="mailto:hi@nrvana.com" class="underline underline-offset-4">hi@nrvana.com</a>.
    </p>
  </section>
</BaseLayout>
