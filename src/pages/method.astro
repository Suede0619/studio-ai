---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="The Nrvana Studio Method">
  <section class="section pt-24 pb-12">
    <h1 class="font-display text-6xl font-semibold tracking-tight leading-[0.95] max-w-4xl">
      Three things "AI design" services skip. <em>We start there.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      The Brand Kernel. The Prompt Library. The Visual Cortex. The unsexy layer that turns a generic AI generator into <em>your</em> generator.
    </p>
  </section>

  <section class="section py-12">
    <p class="text-sm" style="color: var(--color-ink-mute);">
      Method page — full version landing soon. Coming with it: the kernel diagram, real (sanitized) samples,
      a worked example of how the three artifacts compound, and the artist-specific variation.
    </p>
    <div class="mt-8">
      <a href="/services/snapshot" class="btn-accent">In the meantime — Book the Snapshot · $450</a>
    </div>
  </section>
</BaseLayout>
