---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CALL_HREF, SNAPSHOT_HREF, BOOKING_EMAIL } from "../siteConfig";
---

<BaseLayout title="Contact — Nrvana Studio">
  <section class="section pt-24 pb-12">
    <h1 class="font-display text-6xl font-semibold tracking-tight leading-[0.95]">
      Two easy ways to start. <em>Pick whichever feels right.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Not sure yet? Book a free chat. Ready to go? Book the Snapshot. Either way, you're talking to
      a real person — us.
    </p>
  </section>

  <section class="section py-12">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border p-8 flex flex-col" style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">Start free</div>
        <h2 class="mt-3 font-display text-3xl font-semibold">Book a free 20-minute call</h2>
        <p class="mt-3 text-sm flex-1" style="color: var(--color-ink-soft);">
          A relaxed look at your brand and where it could shine. No jargon, no pitch, no commitment —
          just honest, friendly advice. Most people start here.
        </p>
        <a href={CALL_HREF} class="btn-accent mt-6">
          Book your free call →
        </a>
      </div>

      <div class="rounded-2xl border p-8 flex flex-col" style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-alt);">Ready to go</div>
        <h2 class="mt-3 font-display text-3xl font-semibold">Book a Snapshot</h2>
        <p class="mt-3 text-sm flex-1" style="color: var(--color-ink-soft);">
          $450 Design Snapshot, or the $250 Artist Style Snapshot. A few days, a handful of clear
          deliverables, and your first on-brand setup. All yours to keep.
        </p>
        <a href={SNAPSHOT_HREF} class="btn-primary mt-6">
          Book a Snapshot →
        </a>
      </div>
    </div>

    <p class="mt-8 text-sm" style="color: var(--color-ink-mute);">
      Prefer email? Just write us at <a href={`mailto:${BOOKING_EMAIL}`} class="underline underline-offset-4">{BOOKING_EMAIL}</a> — we answer every message ourselves.
    </p>
  </section>
</BaseLayout>
