---
import BaseLayout from "../../layouts/BaseLayout.astro";

const offerings = [
  {
    name: "Artist Visual Audit",
    price: "$250 · 2 days",
    href: "/for-artists/audit",
    desc: "Your voice captured, your tool map, your Glaze/Nightshade posture, two practice workflows you'd actually use, and a recommendation. Yours regardless.",
  },
  {
    name: "Artist Cortex",
    price: "$1,200 · 5 days",
    href: "/for-artists/cortex",
    desc: "Your Voice File, your reference library, two practice workflows installed, your protection posture, and the weekly ritual that keeps the system aligned with how your style is evolving.",
  },
];

const wontDo = [
  "We won't imitate someone else's style to undercut them.",
  "We won't train models on your work without your written consent.",
  "We won't ship 'AI art' that competes with the artists we serve.",
  "We won't recommend tools that flatten your voice into a template.",
];
---

<BaseLayout title="For Artists — Nrvana Studio">
  <section class="section pt-24 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">For artists</div>
    <h1 class="mt-4 font-display text-6xl md:text-7xl font-semibold tracking-tight leading-[0.95] max-w-4xl">
      We respect your process. <em>We just want it to be louder.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Working illustrators, designers, photographers, video artists, motion designers, type designers, 3D artists, animators. Two years of "AI will replace illustrators" headlines. We don't buy it.
    </p>
  </section>

  <section class="section py-12">
    <div class="max-w-3xl">
      <p style="color: var(--color-ink-soft);">
        Your voice is the asset. AI is a power tool you steer. We built a sized-right path so you can engage on your terms — keep your hands on the work, keep your signature, and keep getting hired.
      </p>
      <p class="mt-4" style="color: var(--color-ink-soft);">
        If you're protecting your work with Glaze or Nightshade, we'll help you set those up too. If you're not, we'll show you what your options are. Either way, your call.
      </p>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-4xl font-semibold">The Artist Path</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {offerings.map((o) => (
        <a href={o.href} class="rounded-2xl border p-8 transition hover:-translate-y-1"
           style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
          <h3 class="font-display text-3xl font-semibold">{o.name}</h3>
          <div class="mt-1 text-sm font-medium" style="color: var(--color-accent-deep);">{o.price}</div>
          <p class="mt-4 text-sm" style="color: var(--color-ink-soft);">{o.desc}</p>
          <div class="mt-6 text-sm underline underline-offset-4">See the audit →</div>
        </a>
      ))}
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">What we won't do.</h2>
    <ul class="mt-6 space-y-3 text-sm" style="color: var(--color-ink-soft);">
      {wontDo.map((w) => <li>· {w}</li>)}
    </ul>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-4xl font-semibold">Start with the $250 audit.</h2>
      <p class="mt-3" style="color: var(--color-canvas-soft);">Two days. Five named artifacts. Yours regardless.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact?ref=artist-audit" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-accent); color: var(--color-canvas);">Book the Audit — $250</a>
        <a href="/contact" class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">Just say hi</a>
      </div>
    </div>
  </section>
</BaseLayout>
