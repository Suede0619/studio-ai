---
import BaseLayout from "../../layouts/BaseLayout.astro";

const deliverables = [
  { name: "Your Voice Captured", desc: "A written summary of what makes your style yours, in language AI tools can understand — without trying to imitate." },
  { name: "Your Tool Map", desc: "Which 3–4 AI tools are worth your time given the work you actually do. And the dozens to skip." },
  { name: "Your Glaze / Nightshade Posture", desc: "If you're protecting work from training, the current best practice. If you're not, what the tradeoffs look like." },
  { name: "Two Practice Workflows", desc: "Concrete day-to-day uses — concept exploration, mockups for clients, color test loops — that save hours without touching your hands-on practice." },
  { name: "Your Next Step", desc: "Stop here, DIY from the snapshot, or continue with the Artist Cortex. Explicit recommendation." },
];
---

<BaseLayout title="Artist Style Snapshot — $250 · Nrvana Studio">
  <section class="section pt-24 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent);">For artists</div>
    <h1 class="mt-4 font-display text-6xl font-semibold tracking-tight leading-[0.95] max-w-4xl">
      Your voice, captured. <em>In two days.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Five named artifacts. Sized-right pricing. Artist-first stance. Yours to keep.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-4"
         style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div><div class="mt-1 font-display text-2xl font-semibold">2 days</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Deliverables</div><div class="mt-1 font-display text-2xl font-semibold">5 named</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Your time</div><div class="mt-1 font-display text-2xl font-semibold">90 min</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Fee</div><div class="mt-1 font-display text-2xl font-semibold" style="color: var(--color-accent-deep);">$250 flat</div></div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-4xl font-semibold">What you walk away with</h2>
    <ol class="mt-10 space-y-7">
      {deliverables.map((d, i) => (
        <li class="flex gap-6">
          <div class="font-display text-3xl font-semibold" style="color: var(--color-accent); min-width: 2.5rem;">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div>
            <h3 class="font-display text-2xl font-medium">{d.name}</h3>
            <p class="mt-2" style="color: var(--color-ink-soft);">{d.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section py-12">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-warm);">
      <p class="font-display text-3xl">No imitation. <em>No training on your work without consent.</em></p>
      <p class="mt-3" style="color: var(--color-ink-soft);">
        Hard lines we don't cross. The snapshot is about amplifying you, not flattening you into a generator.
      </p>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-4xl font-semibold">Book the Snapshot.</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact?ref=artist-snapshot" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-accent); color: var(--color-canvas);">Book — $250</a>
        <a href="/contact" class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">Talk first</a>
      </div>
    </div>
  </section>
</BaseLayout>
